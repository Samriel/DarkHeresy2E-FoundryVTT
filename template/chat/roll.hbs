<div class="dark-heresy chat roll" data-actor-id="{{ownerId}}" data-item-id="{{itemId}}" {{#if tokenId}}data-token-id="{{tokenId}}"{{/if}}>
    <div class="background border">
        {{#if isReRoll}}
            <h1>{{#if rerollBy}}{{localize "TALENTS.REROLL_HEADER" name=rerollBy}}{{else}}{{localize "CHAT.REROLL"}}{{/if}}</h1>
        {{/if}}
        <h1>{{name}} ({{target.final}})</h1>
        {{#if flags.isSuccess}}
        <h3 style="color: var(--color-success)">{{localize "CHAT.SUCCESS"}} <span>({{result}})</span></h3>
        {{else}}
        <h3 style="color: var(--color-failure)">{{localize "CHAT.FAILURE"}} <span>({{result}})</span></h3>
        {{/if}}

        <p><strong>{{localize "CHAT.TEST_MODIFIER"}}:</strong> {{target.modifier}}</p>
        {{> "systems/dark-heresy/template/chat/talents.hbs" list=talents}}

        {{#if rolledWith}}
            <p><strong>{{localize "CHAT.ROLLED_WITH"}}:</strong> {{rolledWith}}</p>
        {{/if}}

        {{#if aim}}
            <p><strong>{{localize "CHAT.AIMING"}}:</strong> {{aim.text}}</p>
        {{/if}}
        {{#if rangeText}}
            <p><strong>{{localize "CHAT.ATTACK_RANGE"}}:</strong> {{rangeModText}}</p>
        {{/if}}

        {{#if area.scatter}}
            <p><strong>{{localize "AREA.SCATTER"}}:</strong> {{area.scatter.direction}} / {{area.scatter.distance}} m</p>
        {{/if}}
        {{#if attackType}}
            <p><strong>{{localize "CHAT.ATTACK_TYPE"}}:</strong> {{attackType.text}}</p>
        {{/if}}
        {{#if twoWeapon}}
            <p><em>{{localize "TWO_WEAPON.CHAT" penalty=twoWeapon.penalty}}{{#if twoWeapon.talent}} ({{twoWeapon.talent}}){{/if}}</em></p>
        {{/if}}
        {{#if calledShot}}
            <p><strong>{{localize "DIALOG.CALLED_SHOT_LOCATION"}}:</strong> {{localize calledShot}}</p>
        {{/if}}
        {{#if helplessTarget}}
            <p><em>{{localize "TARGET_STATE.HELPLESS_CHAT"}}</em></p>
        {{/if}}
        {{#if untrained}}
            <p><em>{{localize "WEAPON_TRAINING.CHAT"}}</em></p>
        {{/if}}
        {{#if weaponJam.jammed}}
            <p><strong style="color: var(--color-failure)">{{#if weaponJam.canUnjam}}{{localize "WEAPON_JAM.JAMMED"}}{{else}}{{localize "WEAPON_JAM.JAMMED_SPENT"}}{{/if}}</strong></p>
            {{#if weaponJam.misfire}}
                <p><strong>{{localize "WEAPON_JAM.MISFIRE"}} ({{weaponJam.misfire.result}}):</strong>
                {{#if weaponJam.misfire.detonated}}{{#if weaponJam.misfire.launcher}}{{localize "WEAPON_JAM.MISFIRE_LAUNCHER"}}{{else}}{{localize "WEAPON_JAM.MISFIRE_GRENADE"}}{{/if}}{{else}}{{localize "WEAPON_JAM.MISFIRE_DUD"}}{{/if}}</p>
            {{/if}}
            {{#if weaponJam.canUnjam}}
            <div class="wrapper flex-column"><button class="weapon-unjam">{{localize "WEAPON_JAM.UNJAM"}}</button></div>
            {{/if}}
        {{/if}}
        {{#if weaponJam.overheated}}
            <p><strong style="color: var(--color-failure)">{{localize "WEAPON_JAM.OVERHEATED"}}</strong></p>
            <div class="wrapper flex-column"><button class="weapon-overheat-damage">{{localize "WEAPON_JAM.OVERHEAT_DAMAGE"}}</button></div>
        {{/if}}
        {{#if unjam}}
            {{#if flags.isSuccess}}
            <p><strong>{{localize "WEAPON_JAM.UNJAMMED"}}</strong></p>
            {{else}}
            <p><strong style="color: var(--color-failure)">{{localize "WEAPON_JAM.STILL_JAMMED"}}</strong></p>
            {{/if}}
        {{/if}}

        {{#if fateBonus}}
            <p><em>{{#if (eq fateBonus "applied")}}{{localize "FATE_POINTS.BONUS_APPLIED"}}{{else}}{{localize "FATE_POINTS.BONUS_WASTED"}}{{/if}}</em></p>
        {{/if}}
        {{#if flags.isSuccess}}
            <p><strong>{{localize "CHAT.DOS"}}:</strong> {{dos}}{{#if fateDegrees}} ({{localize "FATE_POINTS.DEGREES_INCLUDED" degrees=fateDegrees}}){{/if}}</p>
            {{#if numberOfHits}}
            <p><strong>{{localize "CHAT.NUMBER_OF_HIT"}}:</strong> {{numberOfHits}}</p>
            {{/if}}
        {{else}}
            <p><strong>{{localize "CHAT.DOF"}}:</strong> {{dof}}</p>
        {{/if}}
        {{#if psy.display}}
            {{#if psy.push}}
            <p><strong>{{localize "CHAT.PSY_RATING"}}:</strong> {{psy.value}} ({{localize "CHAT.PSY_PUSH"}})</p>
            {{else}}
            <p><strong>{{localize "CHAT.PSY_RATING"}}:</strong> {{psy.value}}</p>
            {{/if}}
            {{#if psy.hasPhenomena}}
                {{#if psy.warpConduit}}
                    <p><strong style="color: var(--color-failure)">{{localize "CHAT.HAS_PSYCHIC_PHENOMENA_WITH_WARPCONDUIT"}}</strong></p>
                {{else}}
                    <p><strong style="color: var(--color-failure)">{{localize "CHAT.HAS_PSYCHIC_PHENOMENA"}}</strong></p>
                {{/if}}
                <div class="wrapper flex-column">
                    <button class="roll-phenomena">{{localize "TABLES.ROLL_PHENOMENA"}}{{#if psy.phenomena}} ({{dhSigned psy.phenomena.total}}){{/if}}</button>
                </div>
            {{/if}}
            {{#if area.radius}}
                <p><strong>{{localize "AREA.BLAST"}}:</strong> {{area.radius}} m</p>
            {{/if}}
            {{#if flags.isSuccess}}
                {{#if psy.opposed}}
                    <p><strong>{{localize "PSY.OPPOSED"}}:</strong> {{localize (lookup (config "opposedTests") psy.opposed)}}</p>
                    <div class="wrapper flex-column">
                        {{#each psy.targets}}
                            <button class="psy-opposed" data-token-id="{{tokenId}}" data-scene-id="{{sceneId}}">{{localize "PSY.OPPOSED_BUTTON"}}: {{name}}</button>
                        {{else}}
                            <button class="psy-opposed">{{localize "PSY.OPPOSED_BUTTON_SELECTED"}}</button>
                        {{/each}}
                    </div>
                    <div class="psy-opposed-results"></div>
                {{/if}}
                {{#if psy.sustainable}}
                    <div class="wrapper flex-column">
                        <button class="psy-sustain">{{localize "PSY.SUSTAIN"}}</button>
                    </div>
                {{/if}}
            {{/if}}
        {{/if}}
        {{#if opposedOutcome}}
            <p><strong>{{opposedOutcome.text}}</strong></p>
        {{/if}}
        {{#if suppression}}
            {{#if suppression.hitText}}
            <p><strong>{{localize "PINNING.HITS_ON"}}:</strong> {{suppression.hitText}}</p>
            {{/if}}
            <p>{{localize "PINNING.CARD_TEXT"}}: <strong>{{suppression.pinningText}}</strong></p>
            <div class="wrapper flex-column">
                <button class="invoke-pinning dh-tall">{{localize "PINNING.ROLL"}}</button>
            </div>
        {{/if}}
        {{#if flags.mindTest}}
            {{#unless flags.isSuccess}}
                <div class="wrapper flex-column">
                    <button type="button" class="roll-mind-table">{{localize (concat "MIND.ROLL_" flags.mindTest)}}</button>
                </div>
            {{/unless}}
        {{/if}}
        {{> "systems/dark-heresy/template/chat/talents.hbs" rerolls=talentRerolls actions=talentActions phase="test"}}
        {{#if flags.isAttack}}
            {{#if flags.isSuccess}}
                <div class="wrapper flex-column">
                    <button class="invoke-test">{{localize "CHAT.ROLL_EVASION"}}</button>
                    <button class="invoke-damage">{{localize "CHAT.ROLL_DAMAGE"}}</button>
                </div>
            {{else if area}}
                {{!-- a missed blast still goes off where it scattered --}}
                <div class="wrapper flex-column">
                    <button class="invoke-damage">{{localize "CHAT.ROLL_DAMAGE"}}</button>
                </div>
            {{/if}}
        {{/if}}
    </div>
</div>
