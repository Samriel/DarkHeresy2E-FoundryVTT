<div class="dark-heresy chat roll">
    <div class="background border">
        <h1>{{itemName}}</h1>
        {{#if damageReroll}}
            <p><em>{{localize "TALENTS.DAMAGE_REROLLED" name=damageReroll.name}}</em></p>
        {{/if}}
        {{> "systems/dark-heresy/template/chat/talents.hbs" list=damageTalents}}
        {{#each damages as |damage|}}
            <h3 class="separator damage-location" data-location={{location}}>{{localize location}}{{#if damage.targetName}} — {{damage.targetName}}{{/if}}</h3>
            <div>
                <p><strong>{{localize "CHAT.DAMAGE"}}:</strong> <span class="damage-total">{{damage.total}}</span> 
                <strong class="damage-type">{{damageTypeShort ../weapon.damageType}}</strong>
                {{#if damage.trueDamage}}<span class="damage-true">{{localize "TALENTS.EFFECT.TRUE_DAMAGE" value=damage.trueDamage}}</span>{{/if}}
	            </p>
	        </div>
	        <p><strong>{{localize "CHAT.PENETRATION"}}:</strong> <span class="damage-penetration">{{penetration}}</span></p>
	        {{#if damage.righteousFury}}
	        <p><strong>{{localize "CHAT.RIGHTEOUS_FURY"}}:</strong> <span class="damage-righteous-fury">{{damage.righteousFury}}</span></p>
	        {{/if}}
	    {{/each}}
	    {{#if weapon.special}}
	    <p><strong>{{localize "CHAT.QUALITIES"}}:</strong> {{dhQualities weapon.special}}</p>
	    {{/if}}
	    {{#if sprayJam}}
	    <p><strong style="color: var(--color-failure)">{{localize "AREA.SPRAY_JAM"}}</strong></p>
	    {{/if}}
	    {{> "systems/dark-heresy/template/chat/talents.hbs" rerolls=damageRerolls phase="damage"}}
	    <div class="wrapper flex-column">
	        {{#if weapon.traits.spray}}
	        <button class="spray-dodge">{{localize "AREA.SPRAY_DODGE"}}</button>
	        {{/if}}
	        <button class="apply-damage-targets">{{localize "CHAT.APPLY_DAMAGE_TARGETS"}}</button>
	    </div>
	    <div class="dice-rolls" style="display:none">
	        <h1>{{localize "CHAT.ROLL_TITLE"}}</h1>
		    {{#each damages as |damage|}}
		        <p><strong>{{localize "CHAT.DAMAGE_HEADER"}}</strong></p>
		        <div class="dice-roll-render">
		            {{{damage.damageRender}}}
		        </div>
		        {{#if damage.accurateRender}}
		            <p><strong>{{localize "CHAT.ACCURATE_HEADER"}}</strong></p>
		            <div class="dice-roll-render">
		                {{{damage.accurateRender}}}
		            </div>
		        {{/if}}
		    {{/each}}
	   </div>
    </div> 
</div>