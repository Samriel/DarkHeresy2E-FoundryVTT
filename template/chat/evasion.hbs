<div class="dark-heresy chat roll">
    <div class="background border">
        {{#if isReRoll}}
            <h1>{{#if rerollBy}}{{localize "TALENTS.REROLL_HEADER" name=rerollBy}}{{else}}{{localize "CHAT.REROLL"}}{{/if}}</h1>
        {{/if}}
        <h1>{{name}} ({{target.final}})</h1>
        {{#if flags.isSuccess}}
        <h3><span style="color: var(--color-success)">{{localize "CHAT.SUCCESS"}}</span> ({{result}})</h3>
        {{else}}
        <h3><span style="color: var(--color-failure)">{{localize "CHAT.FAILURE"}}</span> ({{result}})</h3>
        {{/if}}
        <p><strong>{{localize "CHAT.TEST_MODIFIER"}}:</strong> {{modifier}}</p>
        {{> "systems/dark-heresy/template/chat/talents.hbs" list=talents}}
        {{#if fateBonus}}
        <p><em>{{#if (eq fateBonus "applied")}}{{localize "FATE_POINTS.BONUS_APPLIED"}}{{else}}{{localize "FATE_POINTS.BONUS_WASTED"}}{{/if}}</em></p>
        {{/if}}
        {{#if flags.isSuccess}}
            <p><strong>{{localize "CHAT.DOS"}}:</strong> {{dos}}{{#if fateDegrees}} ({{localize "FATE_POINTS.DEGREES_INCLUDED" degrees=fateDegrees}}){{/if}}</p>
        {{else}}
            <p><strong>{{localize "CHAT.DOF"}}:</strong> {{dof}}</p>
        {{/if}}
        {{> "systems/dark-heresy/template/chat/talents.hbs" rerolls=talentRerolls phase="test"}}
        {{#if numberOfHits}}
            <p><strong>{{localize "CHAT.REMAINING_NUMBER_OF_HIT"}}:</strong> {{numberOfHits}}</p>
            <div class="centerBtn"><button class="invoke-damage">{{localize "CHAT.ROLL_DAMAGE"}}</button></div>
        {{/if}}
    </div> 
</div>