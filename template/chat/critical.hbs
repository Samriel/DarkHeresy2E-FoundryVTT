<div class='dark-heresy chat roll'>
    <div class='background border'>
        <h1>Applied Damage to: </h1>
        <h3>{{target}}</h3>
        <ul style="text-align: left; display: inline-block;">
            {{#each rolls}}
            <li>{{damage}} {{damageTypeLong type}} as {{source}} ({{localize location}})
                {{#if effect}}
                <div class="dh-critical-effect">
                    {{#if righteousFury}}
                    <strong>{{localize "TABLES.RF_EFFECT"}}</strong>
                    {{else}}
                    <strong>{{localize "TABLES.CRITICAL_EFFECT" total=total}}</strong>
                    {{/if}}
                    {{> "systems/dark-heresy/template/chat/table-result.hbs" result=effect actorUuid=../actorUuid}}
                    {{#if troopDies}}
                    <p><strong>{{localize "TABLES.RF_TROOP"}}</strong></p>
                    <div class="dh-table-conditions">
                        <button type="button" class="dh-apply-condition" data-uuid="{{../actorUuid}}" data-condition="dead">{{localize "TABLES.APPLY_CONDITION"}}: {{localize "EFFECT.StatusDead"}}</button>
                    </div>
                    {{/if}}
                </div>
                {{/if}}
            </li>
            {{/each}}
        </ul>
        <br>
        {{#if talentNotes}}
        <p><strong>{{localize "TALENTS.CHAT"}}:</strong> {{#each talentNotes}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>
        {{/if}}
        <div>Current <b>Wounds: </b>{{totalWounds}}. <b>Critical Damage: </b>{{totalCritWounds}}</div>
        {{#if (dhReminders special)}}
        <p><strong>{{localize "CHAT.QUALITY_REMINDERS"}}:</strong> {{dhReminders special}}</p>
        {{/if}}
    </div>
</div>
